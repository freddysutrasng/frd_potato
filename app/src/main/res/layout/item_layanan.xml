<?xml version="1.0" encoding="utf-8"?>
<!-- Satu kotak layanan di grid RecyclerView -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    app:cardBackgroundColor="@color/putih"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/hijau_muda"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="150dp"
        android:orientation="vertical"
        android:padding="14dp">

        <ImageView
            android:id="@+id/imgLayanan"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_lingkaran_ikon"
            android:contentDescription="Ikon layanan"
            android:padding="11dp"
            app:tint="@color/hijau_tua" />

        <TextView
            android:id="@+id/tvKategori"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:letterSpacing="0.08"
            android:text="SIMPANAN"
            android:textColor="@color/emas"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNamaLayanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Nama Layanan"
            android:textColor="@color/teks_gelap"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInfoLayanan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Keterangan"
            android:textColor="@color/teks_abu"
            android:textSize="12sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>