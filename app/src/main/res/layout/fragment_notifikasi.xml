<?xml version="1.0" encoding="utf-8"?>
<!-- Tab Notifikasi: pengingat angsuran & status pinjaman (grand design layar 10) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Notifikasi 1: pengingat angsuran -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_kotak_menu"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_lingkaran_ikon"
                android:backgroundTint="@color/emas_muda"
                android:contentDescription="Pengingat angsuran"
                android:padding="11dp"
                android:src="@drawable/ic_angsuran"
                app:tint="@color/emas" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengingat Angsuran"
                    android:textColor="@color/teks_gelap"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Angsuran ke-2 sebesar Rp 333.334 jatuh tempo 25 November 2026."
                    android:textColor="@color/teks_abu"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notifikasi 2: status pinjaman -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_kotak_menu"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_lingkaran_ikon"
                android:contentDescription="Status pinjaman"
                android:padding="11dp"
                android:src="@drawable/ic_pinjaman"
                app:tint="@color/hijau_tua" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pinjaman Disetujui"
                    android:textColor="@color/teks_gelap"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pengajuan pinjaman Rp 1.000.000 (3 bulan) sudah disetujui pengurus."
                    android:textColor="@color/teks_abu"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Notifikasi 3: pengumuman RAT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_kotak_menu"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_lingkaran_ikon"
                android:backgroundTint="@color/biru_muda"
                android:contentDescription="Pengumuman"
                android:padding="11dp"
                android:src="@drawable/ic_message"
                app:tint="@color/biru" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rapat Anggota Tahunan"
                    android:textColor="@color/teks_gelap"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="RAT diadakan Sabtu, 28 November 2026 pukul 09.00 di Balai Afdeling 2."
                    android:textColor="@color/teks_abu"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>