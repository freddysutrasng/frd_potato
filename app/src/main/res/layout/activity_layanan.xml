<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    android:fitsSystemWindows="true"
    tools:context=".Layanan.LayananActivity">

    <!-- Toolbar + tombol back -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- TabLayout: judul tab + ikon + badge -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayanan"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/krem"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"
        app:tabGravity="fill"
        app:tabIconTint="@color/selector_ikon_tab"
        app:tabIndicatorColor="@color/emas"
        app:tabIndicatorFullWidth="false"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/hijau_muda"
        app:tabSelectedTextColor="@color/hijau_tua"
        app:tabTextColor="@color/teks_abu" />

    <!-- ViewPager2: isi tiap tab (bisa digeser kiri/kanan) -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vpLayanan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tabLayanan" />

</androidx.constraintlayout.widget.ConstraintLayout>