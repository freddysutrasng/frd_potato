<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/krem"
    android:orientation="vertical">

    <!-- Header melengkung (Pertemuan 10) di belakang Toolbar -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/background_header"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_header_wave" />

        <!-- Toolbar Halaman Awal: logo + judul aplikasi (tanpa tombol back) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@android:color/transparent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:contentDescription="Logo SI-KSP"
                    android:src="@drawable/ic_logo_siksp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SI-KSP"
                        android:textColor="@color/hijau_tua"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Afdeling 2 · PT BSP"
                        android:textColor="@color/teks_abu"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.MaterialToolbar>
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Sapaan, nama diambil dari SharedPreferences -->
            <TextView
                android:id="@+id/tvSapaan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halo, Anggota 👋"
                android:textColor="@color/teks_gelap"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Selamat datang di Koperasi Simpan Pinjam"
                android:textColor="@color/teks_abu"
                android:textSize="14sp" />

            <!-- Kartu saldo simpanan -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="20dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <!-- Background Drawable: gradasi hijau + lingkaran (bg_kartu_saldo.xml) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_kartu_saldo"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="TOTAL SIMPANAN"
                        android:textColor="@color/hijau_muda"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvSaldo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Rp 100.000"
                        android:textColor="@color/putih"
                        android:textSize="30sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Data contoh, nanti diambil dari database"
                        android:textColor="@color/hijau_muda"
                        android:textSize="12sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Menu Cepat: GridLayout 4 kolom x 2 baris (Pertemuan 11).
                 Baris 1 = 4 tombol cepat di grand design: Setor, Tarik, Pinjam, Angsuran -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Menu Cepat"
                android:textColor="@color/teks_gelap"
                android:textSize="16sp"
                android:textStyle="bold" />

            <androidx.gridlayout.widget.GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="-4dp"
                android:layout_marginTop="8dp"
                app:columnCount="4"
                app:useDefaultMargins="false">

                <!-- 1. Setor -> tab Simpanan -->
                <LinearLayout
                    android:id="@+id/menuSetor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:contentDescription="Setor"
                        android:padding="11dp"
                        android:src="@drawable/ic_setor"
                        app:tint="@color/hijau_tua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Setor"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 2. Tarik -> tab Simpanan -->
                <LinearLayout
                    android:id="@+id/menuTarik"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:backgroundTint="@color/merah_muda"
                        android:contentDescription="Tarik"
                        android:padding="11dp"
                        android:src="@drawable/ic_tarik"
                        app:tint="@color/merah" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Tarik"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 3. Pinjam -> form Pengajuan Pinjaman (Pertemuan 9) -->
                <LinearLayout
                    android:id="@+id/menuPinjam"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:backgroundTint="@color/emas_muda"
                        android:contentDescription="Pinjam"
                        android:padding="11dp"
                        android:src="@drawable/ic_pinjaman"
                        app:tint="@color/emas" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Pinjam"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 4. Angsuran -> tab Pinjaman -->
                <LinearLayout
                    android:id="@+id/menuAngsuran"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:backgroundTint="@color/biru_muda"
                        android:contentDescription="Angsuran"
                        android:padding="11dp"
                        android:src="@drawable/ic_angsuran"
                        app:tint="@color/biru" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Angsuran"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 5. Riwayat -> tab Riwayat -->
                <LinearLayout
                    android:id="@+id/menuRiwayat"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:contentDescription="Riwayat"
                        android:padding="11dp"
                        android:src="@drawable/ic_riwayat"
                        app:tint="@color/hijau_tua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Riwayat"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 6. Pesan dari Pengurus (Pertemuan 10) -->
                <LinearLayout
                    android:id="@+id/menuPesan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:contentDescription="Pesan"
                        android:padding="11dp"
                        android:src="@drawable/ic_message"
                        app:tint="@color/hijau_tua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Pesan"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 7. Layanan: TabLayout + RecyclerView (Pertemuan 11) -->
                <LinearLayout
                    android:id="@+id/menuLayanan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:contentDescription="Layanan"
                        android:padding="11dp"
                        android:src="@drawable/ic_layanan"
                        app:tint="@color/hijau_tua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Layanan"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- 8. Panduan: buka lagi On Board Screen -->
                <LinearLayout
                    android:id="@+id/menuPanduan"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:background="@drawable/bg_kotak_menu"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingVertical="12dp"
                    app:layout_columnWeight="1">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_lingkaran_ikon"
                        android:contentDescription="Panduan"
                        android:padding="11dp"
                        android:src="@drawable/ic_panduan"
                        app:tint="@color/hijau_tua" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:maxLines="1"
                        android:text="Panduan"
                        android:textColor="@color/teks_gelap"
                        android:textSize="11.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </androidx.gridlayout.widget.GridLayout>

            <!-- Kartu Pinjaman Aktif + progress cicilan (grand design layar 04) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pinjaman Aktif"
                android:textColor="@color/teks_gelap"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_kotak_menu"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pokok"
                            android:textColor="@color/teks_abu"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 1.000.000"
                            android:textColor="@color/teks_gelap"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Sisa"
                            android:textColor="@color/teks_abu"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 666.666"
                            android:textColor="@color/merah"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cicilan/bulan"
                            android:textColor="@color/teks_abu"
                            android:textSize="11sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rp 333.334"
                            android:textColor="@color/hijau_tua"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/progressPinjaman"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="3"
                    android:progress="1"
                    app:indicatorColor="@color/hijau"
                    app:trackColor="@color/hijau_muda"
                    app:trackCornerRadius="4dp"
                    app:trackThickness="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Cicilan 1 dari 3 lunas · jatuh tempo berikutnya 25 Nov 2026"
                    android:textColor="@color/teks_abu"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Kartu info koperasi + tombol halaman web -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Info Koperasi"
                android:textColor="@color/teks_gelap"
                android:textSize="16sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="@color/putih"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/hijau_muda"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Kenali koperasi lebih dekat"
                        android:textColor="@color/hijau_tua"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Baca sejarah, prinsip, dan jenis koperasi di Indonesia, termasuk koperasi simpan pinjam."
                        android:textColor="@color/teks_abu"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnWebView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Buka Info Koperasi"
                        app:icon="@drawable/ic_web"
                        app:iconGravity="textStart" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>